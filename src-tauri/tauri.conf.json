{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Simulare 3D Sita Vibratoare",
  "version": "0.1.0",
  "identifier": "com.holcim.cheder-niagara",
  "build": {
  "beforeDevCommand": "npx vite --port 8080",
  "beforeBuildCommand": "npx vite build",
  "devUrl": "http://localhost:8080",
  "frontendDist": "../.vercel/output/static"
},
  "app": {
    "windows": [
      {
        "title": "Simulare 3D Sita Vibratoare",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
